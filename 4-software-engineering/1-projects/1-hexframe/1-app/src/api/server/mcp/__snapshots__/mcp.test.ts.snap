              "enum": [
                -1,
                -2,
                -3,
                -4,
                -5,
                -6,
              ],
              "type": "number",
            },
          ],
          "description": "Where under the parent: a Branch's Direction, 1 to 6, a Leaf's, { leaf: 1 } to { leaf: 6 }, or a Context slot, -1 to -6. It must be free.",
        },
        "title": {
          "description": "The Title: what the Tile is called, never empty.",
          "maxLength": 1000,
          "type": "string",
        },
      },
      "required": [
        "parent",
        "slot",
        "title",
        "preview",
        "body",
      ],
      "type": "object",
    },
    "name": "create_tile",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Changes what a Tile says: any of its Title, its Preview and its Body, the rest left as it is. The Root's Title is the user's name. Answers the Tile as it now reads. Refused with TileNotFound: no Tile of that id in the System, deleted or never there; map or open_tile to find the right one. TitleMissing: the Title is empty; give one. PreviewTooLong: the Preview is over 350 characters; shorten it. HelpReadOnly: that Tile is Help's, which every user reads and none writes; change a Tile of the user's System instead.",
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
