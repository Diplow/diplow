                -5,
                -6,
              ],
              "type": "number",
            },
          ],
          "description": "Where under the parent: a Branch's Direction, 1 to 6, a Leaf's, { leaf: 1 } to { leaf: 6 }, or a Context slot, -1 to -6. It must be free.",
        },
      },
      "required": [
        "id",
        "parent",
        "slot",
      ],
      "type": "object",
    },
    "name": "move_tile",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Two Tiles trade places, each with everything below it: each takes the parent and slot of the other, a Branch, a Leaf or a Context Tile alike, so it works where no slot is free. Answers null. Refused with TileNotFound: no Tile of that id in the System, deleted or never there; map or open_tile to find the right one. RootFixed: the Root is the user; it is never moved, swapped nor deleted. MovedUnderItself: neither Tile may lie below the other; move one of them instead. LeafHoldsNothing: a Leaf is one file, with nothing below it: nothing goes under one, and a Tile holding anything takes no Leaf slot. Move the Leaf to a Branch slot first, or move out what the Tile holds. HelpReadOnly: that Tile is Help's, which every user reads and none writes; change a Tile of the user's System instead.",
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
        "a": {
          "description": "The id of one Tile.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "type": "string",
        },
        "b": {
          "description": "The id of the Tile it trades places with.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "type": "string",
        },
