exports[`the tool table, as an agent lists it > lists every tool as an agent has always seen it: name, description, input and annotations 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Opens one Tile of the user's System: what it says (its Title, Preview and Body, or only the fields asked), its parent, and its Children and Context, each with its Title and Preview only. Without an id, opens the Root, which is the user. Read a System as its author laid it out: open a Tile, read its Children's Previews, then open only the ones that matter to your task. Children say what a Tile does: its Branches (\`branches\`), each with Children and Context of its own, keyed by Direction, 1 to 6 (NW, NE, E, SE, SW, W), and its Leaves (\`leaves\`), each one file with nothing below it, keyed by the same six Directions, their own. Its Context (\`context\`) says what it is, keyed -1 to -6. A Context slot may hold a Reference instead of a Tile: \`_tag: 'Reference'\`, with the id, Title and Preview of the Tile it points at, or \`_tag: 'BrokenReference'\` once that Tile is deleted. Help, hexframe's own guide, is a System every user reads and none writes, from its Root, id "help": open it to learn what a System, a Tile, a Direction or Context is.",
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
        "fields": {
          "description": "What to read of the opened Tile: any of title, preview, body. All three when not given.",
          "items": {
            "enum": [
              "title",
              "preview",
              "body",
            ],
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
              "type": "string",
            },
            {
              "maxLength": 64,
              "pattern": "^help(\\/(1|2|3|4|5|6|-1|-2|-3|-4|-5|-6))*$",
              "type": "string",
            },
          ],
          "description": "A Tile's id, as open_tile and map answer it: a Tile of the user's System, or of Help, from its Root, "help". Without one, the user's Root: the user.",
        },
      },
      "type": "object",
    },
    "name": "open_tile",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Maps the user's System, or Help, below a Tile, the Root when no id is given, several generations at once: depth 0 to 3, 2 when not given, each Tile with its Title and Preview. Use it to find where something lives, then open_tile what matters; ask for body only when you need every Body below, since it costs far more. Children say what a Tile does: its Branches (\`branches\`), each with Children and Context of its own, keyed by Direction, 1 to 6 (NW, NE, E, SE, SW, W), and its Leaves (\`leaves\`), each one file with nothing below it, keyed by the same six Directions, their own. Its Context (\`context\`) says what it is, keyed -1 to -6. A Context slot may hold a Reference instead of a Tile: \`_tag: 'Reference'\`, with the id, Title and Preview of the Tile it points at, or \`_tag: 'BrokenReference'\` once that Tile is deleted. Help, hexframe's own guide, is a System every user reads and none writes, from its Root, id "help": open it to learn what a System, a Tile, a Direction or Context is.",
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
        "depth": {
          "description": "How many generations below the Tile: 0 to 3, 2 when not given.",
          "enum": [
            0,
            1,
            2,
            3,
          ],
          "type": "number",
        },
        "fields": {
          "description": "What to read of each Tile: any of title, preview, body. Title and Preview when not given.",
          "items": {
            "enum": [
              "title",
              "preview",
              "body",
            ],
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
        },
        "id": {
          "anyOf": [
            {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
              "type": "string",
            },
            {
              "maxLength": 64,
              "pattern": "^help(\\/(1|2|3|4|5|6|-1|-2|-3|-4|-5|-6))*$",
              "type": "string",
            },
          ],
          "description": "A Tile's id, as open_tile and map answer it: a Tile of the user's System, or of Help, from its Root, "help". Without one, the user's Root: the user.",
        },
      },
      "type": "object",
    },
    "name": "map",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Adds a Tile to the user's System, in a free slot under a Tile: a Branch, a Leaf, or a Tile of its Context. Directions 1 to 6 (NW, NE, E, SE, SW, W) hold the Branches, { leaf: 1 } to { leaf: 6 } the Leaves, both Children, which say what a Tile does; -1 to -6 hold its Context, which says what it is. A Leaf is one file: nothing goes under it. Answers the new Tile, with its id. Refused with TileNotFound: no Tile of that id in the System, deleted or never there; map or open_tile to find the right one. DirectionTaken: that slot already holds a Tile or a Reference; open_tile on the parent shows which slots are free. A Tile has 6 Branches and 6 Leaves at most, so one more of either is refused: regroup some Children under a new one, by moving them, and the freed Directions take the rest. TitleMissing: the Title is empty; give one. PreviewTooLong: the Preview is over 350 characters; shorten it. LeafHoldsNothing: a Leaf is one file, with nothing below it: nothing goes under one, and a Tile holding anything takes no Leaf slot. Move the Leaf to a Branch slot first, or move out what the Tile holds. HelpReadOnly: that Tile is Help's, which every user reads and none writes; change a Tile of the user's System instead.",
    "inputSchema": {
      "additionalProperties": true,
      "properties": {
        "body": {
          "description": "The Body, in Markdown: everything else the Tile says.",
          "maxLength": 100000,
          "type": "string",
        },
        "parent": {
          "description": "The id of the Tile it goes under, as open_tile and map answer it.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$",
          "type": "string",
        },
        "preview": {
          "description": "The Preview: at most 350 characters, what a reader needs to decide whether to open the Tile.",
          "maxLength": 8000,
          "type": "string",
        },
        "slot": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                4,
                5,
                6,
              ],
              "type": "number",
            },
            {
              "additionalProperties": true,
              "properties": {
